# ── Application & Security ──────────────────────────────────────────────────
PROJECT_NAME="INS Statistical Survey Collection Platform"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pfa_db

# ── Email (Brevo / Sendinblue) ───────────────────────────────────────────────
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@ins.tn
BREVO_SENDER_NAME="INS Statistical Portal"
DEFAULT_LANGUAGE=fr

# ── Redis & Background Worker (Celery) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Integration URLs ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8000
EXT_APP_URL=http://localhost:3000
EXT_TO_PFA_API_KEY=your_ext_integration_api_key_here

# ── CORS Settings (Comma-separated) ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ── Upload Limits & Security Guards ──────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_LOGIN_ATTEMPTS_PER_IP=20
RATE_LIMIT_WINDOW_MINUTES=15
